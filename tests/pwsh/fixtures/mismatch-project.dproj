<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{00000000-0000-0000-0000-000000000003}</ProjectGuid>
        <MainSource>MismatchProject.dpr</MainSource>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>MismatchProject</SanitizedProjectName>
        <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_Keys>CompanyName=TestCo;FileDescription=$(MSBuildProjectName);FileVersion=1.2.3.4;ProductName=$(MSBuildProjectName);ProductVersion=9.0.0.0;Comments=</VerInfo_Keys>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <VerInfo_MajorVer>5</VerInfo_MajorVer>
        <VerInfo_MinorVer>6</VerInfo_MinorVer>
        <VerInfo_Release>7</VerInfo_Release>
        <VerInfo_Build>8</VerInfo_Build>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2_Win32)'!=''">
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_Keys>CompanyName=TestCo;FileDescription=Release build;FileVersion=1.2.3.4;ProductName=SampleProduct;ProductVersion=9.0.0.0;Comments=</VerInfo_Keys>
        <VerInfo_Locale>1033</VerInfo_Locale>
    </PropertyGroup>
</Project>
