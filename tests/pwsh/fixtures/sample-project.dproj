<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{00000000-0000-0000-0000-000000000001}</ProjectGuid>
        <MainSource>SampleProject.dpr</MainSource>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <SanitizedProjectName>SampleProject</SanitizedProjectName>
        <DCC_DcuOutput>.\$(Platform)\$(Config)</DCC_DcuOutput>
        <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
        <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
        <VerInfo_Keys>CompanyName=TestCo;FileDescription=$(MSBuildProjectName);FileVersion=1.2.3.4;InternalName=;LegalCopyright=;LegalTrademarks=;OriginalFilename=;ProgramID=com.test.$(MSBuildProjectName);ProductName=$(MSBuildProjectName);ProductVersion=1.0.0.0;Comments=</VerInfo_Keys>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <VerInfo_MajorVer>1</VerInfo_MajorVer>
        <VerInfo_MinorVer>2</VerInfo_MinorVer>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2_Win32)'!=''">
        <VerInfo_Build>244</VerInfo_Build>
        <VerInfo_Keys>CompanyName=TestCo;FileDescription=Release build;FileVersion=1.2.3.244;InternalName=;LegalCopyright=Copyright (c) 2026;LegalTrademarks=;OriginalFilename=SampleProject.exe;ProgramID=com.test.$(MSBuildProjectName);ProductName=SampleProduct;ProductVersion=1.0.0.0;Comments=</VerInfo_Keys>
        <VerInfo_MajorVer>1</VerInfo_MajorVer>
        <VerInfo_MinorVer>2</VerInfo_MinorVer>
    </PropertyGroup>
</Project>
